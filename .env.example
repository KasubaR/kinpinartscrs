# Copy to .env.local for local development. On cPanel, set these in
# "Setup Node.js App" -> Environment variables instead.

# MySQL database (cPanel prefixes names, e.g. cpuser_crm / cpuser_crmuser)
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Random string of 32+ characters used to sign login cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Optional. Login cookies are Secure (https only) in production. Set to false only if
# you test the production build over plain http.
# COOKIE_SECURE=false
